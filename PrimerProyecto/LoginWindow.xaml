<Window x:Class="PrimerProyecto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="180" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#001133">
    <Grid Margin="12">
        <Grid.Resources>
            <!-- Colores reutilizables -->
            <SolidColorBrush x:Key="BgDark" Color="#001133" />
            <SolidColorBrush x:Key="FgLight" Color="LightBlue" />
            <!-- Marcos en azul claro -->
            <SolidColorBrush x:Key="Border" Color="LightBlue" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bienvenido" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"
                   Foreground="{StaticResource FgLight}" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Usuario" FontSize="11" Foreground="{StaticResource FgLight}" />
            <TextBox x:Name="UsernameTextBox" Width="200" Height="18" Background="{StaticResource BgDark}" Foreground="{StaticResource FgLight}" BorderBrush="{StaticResource Border}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Contraseña" FontSize="11" Foreground="{StaticResource FgLight}" />
            <PasswordBox x:Name="PasswordBox" Width="200" Height="18" Background="{StaticResource BgDark}" Foreground="{StaticResource FgLight}" BorderBrush="{StaticResource Border}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnCancel" Content="Cancelar" Width="52" Height="18" Margin="0,0,6,0" Click="BtnCancel_Click"
                    Background="{StaticResource BgDark}" Foreground="{StaticResource FgLight}" BorderBrush="{StaticResource Border}" />
            <Button x:Name="BtnLogin" Content="Iniciar" Width="64" Height="18" Click="BtnLogin_Click"
                    Background="{StaticResource BgDark}" Foreground="{StaticResource FgLight}" BorderBrush="{StaticResource Border}" />
        </StackPanel>
    </Grid>
</Window>
