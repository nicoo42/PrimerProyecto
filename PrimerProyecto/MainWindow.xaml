<Window x:Class="PrimerProyecto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mi Biblioteca de Juegos" Height="450" Width="800" Background="DarkBlue">
    <!-- Marco exterior fino -->
    <Border BorderBrush="Black" BorderThickness="1" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado: mi perfil a la derecha, menú centrado -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="mi perfil" Grid.Row="0" HorizontalAlignment="Right" Margin="0,4,8,0" FontSize="12" Foreground="LightBlue" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <TextBlock Text="TIENDA" FontSize="13" Margin="18,0" Foreground="LightBlue" Cursor="Hand"/>
                    <TextBlock Text="BIBLIOTECA" FontSize="13" Margin="18,0" FontWeight="Bold" Foreground="White" Cursor="Hand"/>
                    <TextBlock Text="COMUNIDAD" FontSize="13" Margin="18,0" Foreground="LightBlue" Cursor="Hand"/>
                    <TextBlock Text="SOPORTE" FontSize="13" Margin="18,0" Foreground="LightBlue" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Contenido principal -->
            <Grid Grid.Row="1" Margin="24,8,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Panel izquierdo redondeado (Filtros de Biblioteca) -->
                <Border Grid.Column="0" CornerRadius="18" BorderBrush="Black" BorderThickness="1" Height="300" VerticalAlignment="Top" Padding="16">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <TextBlock Text="Todos (3)" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" Foreground="White" />
                        <TextBlock Text="Instalados" FontSize="14" Margin="0,20,0,0" Foreground="LightBlue" />
                        <TextBlock Text="Favoritos" FontSize="14" Margin="0,20,0,0" Foreground="LightBlue" />
                        <TextBlock Text="Completados" FontSize="14" Margin="0,20,0,0" Foreground="LightBlue" />
                        <TextBlock Text="Configuración" FontSize="14" Margin="0,25,0,0" Foreground="LightBlue" />
                    </StackPanel>
                </Border>

                <!-- Área derecha con borde grande (Detalle y Selector de Biblioteca) -->
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Height="300" VerticalAlignment="Top" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Selector horizontal de juegos en la propiedad -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- Juego 1 (Seleccionado con borde cian) -->
                            <Border BorderBrush="Cyan" BorderThickness="2" Width="55" Height="55" Margin="0,0,12,0" Background="#001133" Cursor="Hand">
                                <Image Source="/Recursos/juego1.png" Stretch="UniformToFill"/>
                            </Border>
                            <!-- Juego 2 -->
                            <Border BorderBrush="Black" BorderThickness="1" Width="55" Height="55" Margin="0,0,12,0" Background="DarkBlue" Cursor="Hand">
                                <Image Source="/Recursos/juego2.png" Stretch="UniformToFill"/>
                            </Border>
                            <!-- Juego 3 -->
                            <Border BorderBrush="Black" BorderThickness="1" Width="55" Height="55" Background="DarkBlue" Cursor="Hand">
                                <Image Source="/Recursos/juego3.png" Stretch="UniformToFill"/>
                            </Border>
                        </StackPanel>

                        <!-- 2. Información detallada del juego seleccionado y botón JUGAR -->
                        <Grid Grid.Row="1" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Miniatura grande del juego -->
                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Width="120" Height="160" VerticalAlignment="Top" Background="#001133">
                                <Image Source="/Recursos/juego1.png" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Detalles y botón de acción -->
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                                <TextBlock Text="Cyber Adventure 2077" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Género: Acción / RPG • 45.2 Jugadas" FontSize="11" Foreground="LightBlue" Margin="0,0,0,12"/>

                                <TextBlock Text="Última vez jugado: Ayer" FontSize="12" Foreground="LightBlue" Margin="0,0,0,4"/>
                                <TextBlock Text="Estado: Listo para jugar (Instalado)" FontSize="12" Foreground="Cyan" Margin="0,0,0,25"/>

                                <!-- Botón grande de Jugar estilo cliente de juegos -->
                                <Button Content="JUGAR" Width="130" Height="36" HorizontalAlignment="Left" Background="#0066CC" Foreground="White" FontWeight="Bold" FontSize="14" BorderBrush="Black"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>